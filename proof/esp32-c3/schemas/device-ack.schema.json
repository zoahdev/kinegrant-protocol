{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinegrant.com/proof/esp32-c3/schemas/device-ack.schema.json",
  "title": "KineGrant experimental ESP32-C3 device acknowledgement",
  "type": "object",
  "additionalProperties": false,
  "required": ["alg", "kid", "payload", "signature"],
  "properties": {
    "alg": {"const": "EdDSA"},
    "kid": {"$ref": "#/$defs/keyId"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "profile", "device", "device_id", "command_id", "capability_id", "boot_counter", "sequence", "result", "actuator_count", "ack_id"],
      "properties": {
        "type": {"const": "kinegrant:ExperimentalDeviceAck"},
        "profile": {"const": "kgp-esp32c3-paper-barrier/0.1"},
        "device": {"$ref": "#/$defs/keyId"},
        "device_id": {"type": "string", "minLength": 1},
        "command_id": {"type": "string", "pattern": "^kinegrant:device-command:[0-9a-f]{64}$"},
        "capability_id": {"type": "string", "pattern": "^kinegrant:cap:[0-9a-f]{64}$"},
        "boot_counter": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "result": {"enum": ["succeeded", "failed"]},
        "actuator_count": {"type": "integer", "minimum": 1},
        "ack_id": {"type": "string", "pattern": "^kinegrant:device-ack:[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "keyId": {"type": "string", "pattern": "^kinegrant:key:ed25519:[A-Za-z0-9_-]{43}$"}
  }
}
