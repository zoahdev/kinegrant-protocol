{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinegrant.com/schemas/v0.1/policy-rule.schema.json",
  "title": "KineGrant PolicyRule",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "issuer", "target", "effect", "actions", "subjects", "purposes", "constraints", "obligations", "priority", "source"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 1},
    "effect": {"enum": ["allow", "deny"]},
    "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "subjects": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "purposes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "not_before": {"type": "string", "format": "date-time"},
        "not_after": {"type": "string", "format": "date-time"},
        "required_context": {"type": "object"},
        "requires_human_present": {"type": "boolean"},
        "max_risk_tier": {"type": "integer", "minimum": 0},
        "max_force_newtons": {"type": "number", "minimum": 0},
        "max_velocity_mps": {"type": "number", "minimum": 0},
        "allowed_zones": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "min_approval_tier": {"type": "integer", "minimum": 0, "maximum": 2}
      }
    },
    "obligations": {"type": "array", "items": {"enum": ["emitActionReceipt"]}, "uniqueItems": true},
    "priority": {"type": "integer"},
    "source": {"type": "object"}
  }
}
