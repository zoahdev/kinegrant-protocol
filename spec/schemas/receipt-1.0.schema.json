{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinegrant.com/schemas/v1.0/receipt.schema.json",
  "title": "KineGrant signed PhysicalActionReceipt 1.0 (additive)",
  "type": "object",
  "additionalProperties": false,
  "required": ["alg", "kid", "payload", "signature"],
  "properties": {
    "alg": {"const": "EdDSA"},
    "kid": {"type": "string", "pattern": "^kinegrant:key:ed25519:[A-Za-z0-9_-]{43}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "executor", "capability_id", "request_digest", "agent", "target", "action", "purpose", "result", "started_at", "finished_at", "evidence_hash", "previous_receipt_hash", "receipt_id"],
      "properties": {
        "type": {"const": "kinegrant:PhysicalActionReceipt"},
        "version": {"const": "1.0"},
        "executor": {"type": "string", "pattern": "^kinegrant:key:ed25519:[A-Za-z0-9_-]{43}$"},
        "capability_id": {"type": "string", "pattern": "^kinegrant:cap:[0-9a-f]{64}$"},
        "request_digest": {"$ref": "#/$defs/digest"},
        "agent": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "result": {"enum": ["succeeded", "failed", "aborted"]},
        "started_at": {"type": "string", "format": "date-time"},
        "finished_at": {"type": "string", "format": "date-time"},
        "evidence_hash": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "previous_receipt_hash": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "receipt_id": {"type": "string", "pattern": "^kinegrant:receipt:[0-9a-f]{64}$"},
        "approval_tier": {"type": "integer", "minimum": 0, "maximum": 2},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_force_newtons": {"type": "number", "minimum": 0},
            "max_velocity_mps": {"type": "number", "minimum": 0},
            "allowed_zones": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "parent_capability_id": {"type": ["string", "null"], "minLength": 1},
        "obligation_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["obligation", "status"],
            "properties": {
              "obligation": {"enum": ["emitActionReceipt", "logAuditEvent", "preserveEvidence"]},
              "status": {"enum": ["satisfied", "pending", "failed"]},
              "failure_reason": {
                "anyOf": [
                  {"type": "null"},
                  {"type": "string", "minLength": 1}
                ]
              }
            }
          }
        },
        "failure_reason": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
