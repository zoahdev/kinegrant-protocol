{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kinegrant.com/schemas/v0.2/capability.schema.json",
  "title": "KineGrant signed PhysicalActionCapability v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["alg", "kid", "payload", "signature"],
  "properties": {
    "alg": {"const": "EdDSA"},
    "kid": {"type": "string", "pattern": "^kinegrant:key:ed25519:[A-Za-z0-9_-]{43}$"},
    "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "version", "issuer", "agent", "target", "actions", "purposes",
        "request_digest", "policy_digest", "matched_policy_ids", "obligations",
        "issued_at", "not_before", "expires_at", "nonce", "capability_id",
        "parent_capability_id", "constraints", "approval_tier",
        "delegation_allowed", "max_delegation_depth", "delegate_agent", "delegation_depth"
      ],
      "properties": {
        "type": {"const": "kinegrant:PhysicalActionCapability"},
        "version": {"const": "0.2"},
        "issuer": {"type": "string", "pattern": "^kinegrant:key:ed25519:[A-Za-z0-9_-]{43}$"},
        "agent": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "purposes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "request_digest": {"$ref": "#/$defs/digest"},
        "policy_digest": {"$ref": "#/$defs/digest"},
        "matched_policy_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "obligations": {"type": "array", "items": {"enum": ["emitActionReceipt"]}, "uniqueItems": true},
        "issued_at": {"type": "string", "format": "date-time"},
        "not_before": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "nonce": {"type": "string", "minLength": 20},
        "capability_id": {"type": "string", "pattern": "^kinegrant:cap:[0-9a-f]{64}$"},
        "parent_capability_id": {"type": ["string", "null"], "minLength": 1},
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_force_newtons": {"type": "number", "minimum": 0},
            "max_velocity_mps": {"type": "number", "minimum": 0},
            "allowed_zones": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "approval_tier": {"type": "integer", "minimum": 0, "maximum": 2},
        "delegation_allowed": {"type": "boolean"},
        "max_delegation_depth": {"type": "integer", "minimum": 0, "maximum": 3},
        "delegate_agent": {"type": ["string", "null"], "minLength": 1},
        "delegation_depth": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
