{
  "name": "KineGrant external reproduction",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install --disable-pip-version-check -e '.[test]'",
  "postStartCommand": "python challenge/reproduce.py --output-dir reproduction-output && python challenge/verify_reproduction.py reproduction-output/reproduction-report.json",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
